{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Name of the resource group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "environment": {
      "type": "string",
      "allowedValues": ["dev", "staging", "prod"],
      "defaultValue": "dev",
      "metadata": {
        "description": "Environment name"
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service Plan SKU"
      }
    },
    "redisCacheSku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": ["Basic", "Standard", "Premium"],
      "metadata": {
        "description": "Redis Cache SKU"
      }
    },
    "redisCacheSize": {
      "type": "string",
      "defaultValue": "C0",
      "metadata": {
        "description": "Redis Cache size"
      }
    },
    "signalRSku": {
      "type": "string",
      "defaultValue": "Free_F1",
      "allowedValues": ["Free_F1", "Standard_S1"],
      "metadata": {
        "description": "SignalR Service SKU"
      }
    },
    "deploySignalR": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether to deploy Azure SignalR Service"
      }
    },
    "deployContainerRegistry": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether to deploy Azure Container Registry"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[concat(parameters('environment'), '-', uniqueString(resourceGroup().id))]",
    "redisCacheName": "[concat('wanc-redis-', variables('uniqueSuffix'))]",
    "appServicePlanName": "[concat('wanc-plan-', variables('uniqueSuffix'))]",
    "appServiceName": "[concat('wanc-app-', variables('uniqueSuffix'))]",
    "containerRegistryName": "[concat('wancregistry', replace(variables('uniqueSuffix'), '-', ''))]",
    "signalRName": "[concat('wanc-signalr-', variables('uniqueSuffix'))]",
    "keyVaultName": "[concat('wanc-kv-', variables('uniqueSuffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2021-06-01-preview",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": false,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "networkAcls": {
          "defaultAction": "Allow",
          "bypass": "AzureServices"
        }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-02-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServicePlanSku')]",
        "tier": "[parameters('appServicePlanSku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "condition": "[parameters('deployContainerRegistry')]",
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2021-12-01-preview",
      "name": "[variables('containerRegistryName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": true
      }
    },
    {
      "type": "Microsoft.Cache/Redis",
      "apiVersion": "2020-12-01",
      "name": "[variables('redisCacheName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "[parameters('redisCacheSku')]",
          "family": "[if(equals(parameters('redisCacheSku'), 'Premium'), 'P', if(equals(parameters('redisCacheSku'), 'Standard'), 'C', 'C'))]",
          "capacity": "[if(equals(parameters('redisCacheSize'), 'C0'), 0, if(equals(parameters('redisCacheSize'), 'C1'), 1, if(equals(parameters('redisCacheSize'), 'C2'), 2, 1)))]"
        },
        "enableNonSslPort": false,
        "minimumTlsVersion": "1.2"
      }
    },
    {
      "condition": "[parameters('deploySignalR')]",
      "type": "Microsoft.SignalRService/signalR",
      "apiVersion": "2022-02-01",
      "name": "[variables('signalRName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('signalRSku')]",
        "tier": "[if(equals(parameters('signalRSku'), 'Free_F1'), 'Free', 'Standard')]"
      },
      "properties": {
        "features": [
          {
            "flag": "ServiceMode",
            "value": "Default"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[variables('appServiceName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ],
      "kind": "app,linux,container",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "DOCKER|nginx:alpine",
          "appSettings": [
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "false"
            },
            {
              "name": "DOCKER_ENABLE_CI",
              "value": "true"
            },
            {
              "name": "WEBSITES_PORT",
              "value": "8080"
            },
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "[parameters('environment')]"
            },
            {
              "name": "KeyVault:VaultUri",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2021-06-01-preview').properties.vaultUri]"
            }
          ]
        }
      },
      "identity": {
        "type": "SystemAssigned"
      }
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "appServiceName": {
      "type": "string",
      "value": "[variables('appServiceName')]"
    },
    "appServiceUrl": {
      "type": "string",
      "value": "[concat('https://', variables('appServiceName'), '.azurewebsites.net')]"
    },
    "redisCacheName": {
      "type": "string",
      "value": "[variables('redisCacheName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "containerRegistryName": {
      "type": "string",
      "value": "[if(parameters('deployContainerRegistry'), variables('containerRegistryName'), '')]"
    },
    "signalRName": {
      "type": "string",
      "value": "[if(parameters('deploySignalR'), variables('signalRName'), '')]"
    }
  }
}
